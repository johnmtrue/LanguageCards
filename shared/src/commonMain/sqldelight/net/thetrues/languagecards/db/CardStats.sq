CREATE TABLE card_stats (
  card_id TEXT PRIMARY KEY NOT NULL REFERENCES card(id),
  hits INTEGER NOT NULL DEFAULT 0,
  misses INTEGER NOT NULL DEFAULT 0
);

selectByCardId:
SELECT *
FROM card_stats
WHERE card_id = ?;

selectAll:
SELECT *
FROM card_stats;

insertOrReplace:
INSERT OR REPLACE INTO card_stats(card_id, hits, misses)
VALUES (?, ?, ?);

recordHit:
UPDATE card_stats
SET hits = hits + 1
WHERE card_id = ?;

recordMiss:
UPDATE card_stats
SET misses = misses + 1
WHERE card_id = ?;

-- Insert row if not exists (for first record of a card)
insertIfNotExists:
INSERT OR IGNORE INTO card_stats(card_id, hits, misses)
VALUES (?, 0, 0);

deleteAll:
DELETE FROM card_stats;
