-- Migrate card_stats from (card_id PK) to (card_id, direction) composite PK.
-- Existing stats are attributed to A_TO_B direction.
CREATE TABLE card_stats_new (
  card_id TEXT NOT NULL REFERENCES card(id),
  direction TEXT NOT NULL,
  hits INTEGER NOT NULL DEFAULT 0,
  misses INTEGER NOT NULL DEFAULT 0,
  PRIMARY KEY (card_id, direction)
);
INSERT INTO card_stats_new (card_id, direction, hits, misses)
SELECT card_id, 'A_TO_B', hits, misses FROM card_stats;
DROP TABLE card_stats;
ALTER TABLE card_stats_new RENAME TO card_stats;
